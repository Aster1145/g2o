{
  // Use the project virtual environment (created by `python -m venv .venv`)
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,

  // Linux / macOS users: uncomment the next line instead of the one above
  // "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // Discover the tests in unit_test/ for the Testing panel
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": ["-v", "-s", "./unit_test", "-p", "test_*.py", "-t", "."],
  "python.testing.cwd": "${workspaceFolder}",

  // Keep the explorer tidy
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  // Maps and recordings are useful to see, but not to edit
  "files.associations": { "*.g2o": "plaintext" },
  "editor.rulers": [88]
}
